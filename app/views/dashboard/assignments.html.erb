<div class="max-w-4xl mx-auto mt-10 p-6 bg-white rounded-lg shadow-md">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Course Assignments</h1>
    <%= link_to "← Back to Courses", root_path, class: "text-blue-600 hover:underline" %>
  </div>

  <% if @error %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <strong>Error:</strong> <%= @error %>
    </div>
  <% else %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Assignment Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Due Date</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Points</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @assignments.each do |assignment| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= assignment['name'] %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= assignment['due_at'] ? Time.parse(assignment['due_at']).strftime("%b %d, %Y %I:%M %p") : "No due date" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= assignment['points_possible'] || 'N/A' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>